+            if process and process.poll() is None:
+                process.kill()
+                process.communicate(timeout=5)
+            server.shutdown()
+            server.server_close()
+            listener.join(timeout=2)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
