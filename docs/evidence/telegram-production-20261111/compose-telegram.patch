--- compose-before.yaml
+++ compose-telegram.yaml
@@ -32,6 +32,8 @@
     SESSION_SECURE_COOKIE: ${SESSION_SECURE_COOKIE:-false}
     CACHE_STORE: database
     QUEUE_CONNECTION: database
+    TELEGRAM_ENABLED: 'true'
