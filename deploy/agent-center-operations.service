[Unit]
Description=Agent Center fixed infrastructure health observations
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/agent-center/scripts/collect-operations.py --output /var/lib/docker/volumes/agent-center_app_storage/_data/framework/operations-probes.json
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/docker/volumes/agent-center_app_storage/_data/framework
